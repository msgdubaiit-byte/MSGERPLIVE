# ========================================================================
# MSG OILFIELD ERP - SUPABASE POSTGRESQL & VERCEL CONFIGURATION
# Copy this file to .env locally, and add these variables in Vercel Settings
# ========================================================================

# REQUIRED: Direct Supabase PostgreSQL connection string (Pooler or Direct URI)
# Found in Supabase Dashboard -> Connect -> Session / Transaction Pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# REQUIRED in production: Strong random JWT signing key (64+ chars)
JWT_SECRET=replace-with-strong-random-64-char-secret

# Supabase REST / Realtime Client Configuration
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Cloudinary Cloud Storage (for durable MTC/PDF files on serverless Vercel)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
CLOUDINARY_FOLDER=msg-oilfield-erp
