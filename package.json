{
  "name": "msg-oilfield-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "start": "vite --host",
    "server": "python -m uvicorn server.main:app --host 0.0.0.0 --port 8000 --reload",
    "build": "tsc -b && vite build",
    "lint": "oxlint --quiet",
    "test:backend": "python -m pytest server/tests --cov=server --cov-report=term-missing -v",
    "test:frontend": "vitest run --coverage",
    "test:e2e": "node tests/e2e/playwright.e2e.mjs",
    "test:all": "npm run lint && npm run build && npm run test:backend && npm run test:frontend && npm run test:e2e",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.63.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.2",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.32",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.2"
  }
}
